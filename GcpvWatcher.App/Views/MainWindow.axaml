<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GcpvWatcher.App.ViewModels"
        xmlns:converters="using:GcpvWatcher.App.Converters"
        xmlns:models="using:GcpvWatcher.App.Models"
        x:Class="GcpvWatcher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GcpvWatcher Directory Monitor"
        Width="600" Height="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:RacersToStringConverter x:Key="RacersToStringConverter" />
        <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
        <converters:RaceToBackgroundConverter x:Key="RaceToBackgroundConverter" />
        <converters:RaceBackgroundMultiConverter x:Key="RaceBackgroundMultiConverter" />
        <converters:RaceNumberToIsConsolidatedConverter x:Key="RaceNumberToIsConsolidatedConverter" />
    </Window.Resources>
    
    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
        </Style>
        
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        
        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="WhiteSmoke" />
        </Style>
        
        <Style Selector="TabControl">
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="GCPV FinishLynx Bridge" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,30" />

        <!-- Watch Directory Section -->
        <TextBlock Grid.Row="1" 
                   Text="Watch Directory:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5" />
        
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" 
                     Text="{Binding WatchDirectory}" 
                     IsReadOnly="True" 
                     FontSize="12" 
                     Margin="0,0,10,0" />
            
            <Button Grid.Column="1" 
                    Content="Browse..." 
                    Command="{Binding BrowseWatchDirectoryCommand}" 
                    Width="80" 
                    Height="30" />
        </Grid>

        <!-- FinishLynx Event Directory Section -->
        <TextBlock Grid.Row="3" 
                   Text="FinishLynx Event Directory:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5" />
        
        <Grid Grid.Row="4" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" 
                     Text="{Binding FinishLynxDirectory}" 
                     IsReadOnly="True" 
                     FontSize="12" 
                     Margin="0,0,10,0" />
            
            <Button Grid.Column="1" 
                    Content="Browse..." 
                    Command="{Binding BrowseFinishLynxDirectoryCommand}" 
                    Width="80" 
                    Height="30" />
        </Grid>

        <!-- Status Section -->
        <Grid Grid.Row="5" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Status:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" />
            
            <TextBlock Grid.Column="1" 
                       Text="{Binding Status}" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       Foreground="{Binding StatusColor}" />
        </Grid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    Spacing="20"
                    Margin="0,0,0,15">
            <CheckBox Content="Consolidate Single-Racer Races"
                      IsChecked="{Binding ConsolidateSingleRacerRaces}" />
            <CheckBox Content="Clean event names"
                      IsChecked="{Binding ApplyParsingRules}" />
        </StackPanel>

        <Grid Grid.Row="7" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Track length:"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TrackLengthChoices}"
                      SelectedItem="{Binding SelectedTrackLength}"
                      HorizontalAlignment="Left"
                      MinWidth="140"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackLengthChoice">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="8" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Spacing="15"
                    Margin="0,0,0,20">
            <Button Content="Start Watching" 
                    Command="{Binding StartWatchingCommand}" 
                    IsEnabled="{Binding CanStartWatching}"
                    Width="120" 
                    Height="35" />
            <Button Content="Stop Watching" 
                    Command="{Binding StopWatchingCommand}" 
                    IsEnabled="{Binding CanStopWatching}"
                    Width="120" 
                    Height="35" />
            <Button Content="Close" 
                    Command="{Binding CloseCommand}" 
                    Width="80" 
                    Height="35" />
        </StackPanel>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="9" 
                    Margin="0,0,0,0"
                    x:Name="MainTabControl"
                    SelectionChanged="OnTabSelectionChanged">
            <TabItem Header="Races" x:Name="RacesTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,8">
                        <TextBox Text="{Binding BulkLapsText}"
                                 Watermark="Laps"
                                 Width="70" />
                        <Button Content="Set laps for selected"
                                Command="{Binding SetSelectedLapsCommand}" />
                        <Button Content="Reset selected"
                                Command="{Binding ResetSelectedCommand}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Races}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RaceRowViewModel">
                                    <Border BorderBrush="DarkGray"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Margin="0,2"
                                            Padding="8">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource RaceBackgroundMultiConverter}">
                                                <Binding Path="IsFromKeepFile" />
                                                <Binding Path="RaceNumber" />
                                            </MultiBinding>
                                        </Border.Background>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,8,0" />
                                                <TextBlock Text="Race "
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RaceNumber}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" (Keep File)"
                                                           FontSize="10"
                                                           Foreground="DarkOrange"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsFromKeepFile}" />
                                                <TextBlock Text=" (Consolidated)"
                                                           FontSize="10"
                                                           Foreground="DarkGreen"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding RaceNumber, Converter={StaticResource RaceNumberToIsConsolidatedConverter}}" />
                                                <TextBlock Text=" Edited"
                                                           FontSize="10"
                                                           Foreground="DarkBlue"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsOverridden}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding TitleText}"
                                                     FontSize="11"
                                                     Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="6">
                                                <TextBox Text="{Binding LapsText}"
                                                         Width="60"
                                                         FontSize="11" />
                                                <TextBlock Text="laps"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="DarkBlue" />
                                                <Button Content="Save"
                                                        Command="{Binding SaveCommand}"
                                                        Padding="8,2" />
                                                <Button Content="Reset"
                                                        Command="{Binding ResetCommand}"
                                                        Padding="8,2"
                                                        IsVisible="{Binding IsOverridden}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TrackWarning}"
                                                       IsVisible="{Binding HasTrackWarning}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#B91C1C"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding TrackCaution}"
                                                       IsVisible="{Binding HasTrackCaution}"
                                                       FontSize="10"
                                                       Foreground="#A16207"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Race, Converter={StaticResource RacersToStringConverter}}"
                                                       FontSize="9"
                                                       FontFamily="Consolas, Courier New, monospace"
                                                       Foreground="DarkBlue"
                                                       Margin="0,1,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            
            <TabItem Header="Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogContent}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             FontFamily="Consolas, Courier New, monospace" 
                             FontSize="11" 
                             Background="White" 
                             Foreground="Black" 
                             BorderThickness="0" />
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Raw Lynx.evt" 
                     x:Name="RawEvtTab"
                     IsEnabled="{Binding IsRawEvtTabEnabled}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding RawEvtContent}" 
                             IsReadOnly="True" 
                             TextWrapping="NoWrap" 
                             AcceptsReturn="True" 
                             FontFamily="Consolas, Courier New, monospace" 
                             FontSize="11" 
                             Background="White" 
                             Foreground="Black" 
                             BorderThickness="0" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

